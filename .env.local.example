# Turso database credentials (obtain from Turso dashboard or CLI)
# NEVER commit .env.local to git
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Auth: hardcoded single user credentials (change these)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Session cookie secret (generate a random 32+ char string)
SESSION_SECRET=replace-with-32-or-more-random-characters
